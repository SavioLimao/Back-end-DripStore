generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model usuarios {
  id         Int      @id @default(autoincrement())
  nome       String
  cpf        String   @unique
  email      String   @unique
  senha      String
  telefone   String?
  nascimento DateTime
}
